# Copy to env.sh and set the paths. Every script in this folder starts with `source env.sh`.
export DUROOM_REPO=/path/to/duroom-code            # repository root
export DUROOM_OUT=/path/to/duroom-out              # all outputs
export DUROOM_EMB=/path/to/observer_embeddings     # corpus embeddings: clip-vit-l-14.npz, dinov3-l.npz, siglip-so400m.npz
export WIKIART_DIR=/path/to/wikiart                # artwork_images/<id>.jpg, artist_data/artwork_data_merged.csv, artwork_data/artwork_style_embeddings.npz, artwork_data/delete_ids.txt
export DUROOM_PY=/path/to/conda_env/bin/python     # python 3.10 with requirements.txt installed
export DUROOM_SEARCH_ENV=/path/to/search_env      # prefix of the loop/render environment (requirements-search.txt); search/sphere.sbatch reads it as SPHERE_ENV
export HF_HOME=/path/to/hf_cache                   # Hugging Face cache with the encoder and decoder weights
export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
